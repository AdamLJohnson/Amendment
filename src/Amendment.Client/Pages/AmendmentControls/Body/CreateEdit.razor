@page "/Amendment/{AmendmentId}/Body/Create/{CreateLanguage?}"
@page "/Amendment/{AmendmentId}/Body/Edit/{EditLanguage}"
@using Microsoft.AspNetCore.Authorization
@using Amendment.Client.Repository.GraphQl
@using Amendment.Shared
@attribute [Authorize(Roles = RoleGroups.AdminTranslatorAmendEditor)]
@inject IAmendmentApi Api
@inject NavigationManager NavigationManager
@inject INotificationService NotificationService
<CustomPageTitle>@_title</CustomPageTitle>
<h3>@_amendment?.Title</h3>

<Row>
    <Column>
        <EditForm Model="this" OnValidSubmit="OnSave">
                <Field>
                    <FieldLabel For="status">Status</FieldLabel>
                    <Select id="status" @bind-Value="@_status" TValue="string">
                        <ChildContent>
                            <Repeater Items="Statuses">
                                <ChildContent Context="item">
                                    <SelectItem Value="@item.Value">@item.Label</SelectItem>
                                </ChildContent>
                            </Repeater>
                        </ChildContent>
                    </Select>
                </Field>
                <Field>
                    <FieldLabel For="language">Language</FieldLabel>
                    <Select id="language" @bind-Value="@_language" TValue="string" Disabled="@(EditLanguage != null)">
                        <ChildContent>
                            <Repeater Items="_languages">
                                <ChildContent Context="item">
                                    <SelectItem Value="@item.Code">@item.Name</SelectItem>
                                </ChildContent>
                            </Repeater>
                        </ChildContent>
                    </Select>
                </Field>
                <Field>
                    <FieldLabel For="amendmentBody">Amendment Body</FieldLabel>
                    @if (_initialized && _loaded)
                    {
                        <Markdown Value="@_markdown" id="amendmentBody" ValueChanged="MarkdownValueChanged" UploadImage="false" SpellChecker="false" InsertTexts=@(new MarkdownInsertTexts() {HorizontalRule = new []{"", "**NEWSLIDE**"}, Link = new []{"<u>", "</u>"}, Table = new []{"<span style=\"color: red;\">", "</span>"}})>
                            <Toolbar>
                                <MarkdownToolbarButton Action="MarkdownAction.Bold"/>
                                <MarkdownToolbarButton Action="MarkdownAction.Italic" />
                                <MarkdownToolbarButton Action="MarkdownAction.Strikethrough" />
                                <MarkdownToolbarButton Action="MarkdownAction.Link" Icon="fa fa-underline" />
                                @*<MarkdownToolbarButton Action="MarkdownAction.Table" Icon="fa fa-tint" />*@
                                <MarkdownToolbarButton Action="MarkdownAction.Heading" />
                                <MarkdownToolbarButton Action="MarkdownAction.Quote" Separator />
                                <MarkdownToolbarButton Action="MarkdownAction.UnorderedList" />
                                <MarkdownToolbarButton Action="MarkdownAction.OrderedList" />
                                <MarkdownToolbarButton Action="MarkdownAction.Link" Separator />
                                <MarkdownToolbarButton Action="MarkdownAction.Image" />
                                <MarkdownToolbarButton Action="MarkdownAction.HorizontalRule" Icon="fa fa-plus" Separator />
                            </Toolbar>
                        </Markdown>
                    }
                </Field>

            <Button Color="Color.Primary" Type="ButtonType.Submit">Save</Button>
        </EditForm>
    </Column>
    <Column Class="amendment-body-tabs">
        <Tabs SelectedTab="@_selectedTab" SelectedTabChanged="SelectedTabChanged">
            <Items>
                <Tab Name="primaryLanguageTab">@_primaryLanguageName</Tab>
                <Tab Name="preview">Preview</Tab>
            </Items>
            <Content>
                <TabPanel Name="primaryLanguageTab" Class="tab-pane">
                    <AmendmentBodyMultiRenderer BodyText="@(_primaryLanguageBody?.Markdown ?? "")"></AmendmentBodyMultiRenderer>
                </TabPanel>
                <TabPanel Name="preview" Class="tab-pane">
                    <Div class="text-preview">
                        <AmendmentBodyMultiRenderer BodyText="@_markdown"></AmendmentBodyMultiRenderer>
                    </Div>
                </TabPanel>
            </Content>
        </Tabs>
    </Column>
</Row>


@code {
    [Parameter]
    public string AmendmentId { get; set; } = "";
    [Parameter]
    public string? CreateLanguage { get; set; }
    [Parameter]
    public string? EditLanguage { get; set; }
    string _title = "";
    string _selectedTab = "primaryLanguageTab";

    ApiAmendment? _amendment;
    ApiAmendmentBody? _primaryLanguageBody;
    ApiAmendmentBody? _body;
    string _primaryLanguageName = "English";

    static readonly (string Value, string Label)[] Statuses =
    [
        (ApiBodyStatus.New, "New"), (ApiBodyStatus.Draft, "Draft"), (ApiBodyStatus.UnderReview, "Under Review"), (ApiBodyStatus.Ready, "Ready")
    ];
    string _status = ApiBodyStatus.New;
    string _language = "";
    string _markdown = "";
    List<ApiLanguage> _languages = new();
    private bool _initialized;
    private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _initialized = true;
            StateHasChanged(); // Trigger render of Markdown now that DOM is ready
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _title = EditLanguage == null ? "Create Amendment Body" : "Edit Amendment Body";
        try
        {
            _languages = (await Api.GetLanguagesAsync()).ToList();
            _amendment = await Api.GetAmendmentAsync(AmendmentId);
        }
        catch (AmendmentApiException ex)
        {
            await NotificationService.Error(ex.Message, "Amendment Body Error");
            return;
        }
        if (_amendment == null)
        {
            await NotificationService.Error("The amendment was not found.", "Amendment Body Error");
            return;
        }

        _primaryLanguageName = _languages.FirstOrDefault(x => x.Code == _amendment.PrimaryLanguage)?.Name ?? _amendment.PrimaryLanguage;
        _primaryLanguageBody = _amendment.Bodies.FirstOrDefault(x => x.Language == _amendment.PrimaryLanguage);

        if (EditLanguage != null)
        {
            _body = _amendment.Bodies.FirstOrDefault(x => x.Language == EditLanguage);
            if (_body == null)
            {
                await NotificationService.Error("The amendment body was not found.", "Amendment Body Error");
                return;
            }
            _language = _body.Language;
            _status = _body.Status;
            _markdown = _body.Markdown;
        }

        _languages.RemoveAll(x => _amendment.Bodies.Any(y => y.Language == x.Code && y.Language != _language));
        if (EditLanguage == null)
            _language = CreateLanguage != null && _languages.Any(x => x.Code == CreateLanguage) ? CreateLanguage : _languages.FirstOrDefault()?.Code ?? "";
        _loaded = true;
    }

    protected async Task OnSave()
    {
        if (_amendment == null)
            return;
        if (string.IsNullOrEmpty(_markdown))
        {
            await NotificationService.Error("Amendment Body can not be empty", "Error");
            return;
        }

        try
        {
            if (_body == null)
                await Api.CreateBodyAsync(AmendmentId, _language, _markdown, _status);
            else
                _body = await Api.UpdateBodyAsync(AmendmentId, _body.Language, _body.Version, _markdown, _status);
            NavigationManager.NavigateTo("/Amendment");
        }
        catch (AmendmentApiException ex)
        {
            // Keep the form with the user's input intact
            await NotificationService.Error(ex.Message, "Validation Error");
        }
        StateHasChanged();
    }

    private Task MarkdownValueChanged(string value)
    {
        _markdown = value;
        return Task.CompletedTask;
    }

    private void SelectedTabChanged(string tabName)
    {
        _selectedTab = tabName;
    }
}

