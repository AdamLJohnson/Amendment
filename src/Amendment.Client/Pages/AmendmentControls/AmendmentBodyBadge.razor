@using Amendment.Client.Repository.GraphQl
@using Amendment.Shared

@if (Amendment.Bodies.FirstOrDefault(x => x.Language == Language.Code) is { } body)
{
    Background bg = Background.Primary;
    if (body.Status == ApiBodyStatus.Ready)
    {
        bg = Background.Success;
    }
    if (Amendment.IsApproved)
    {
        bg = Background.Info;
    }
    if (IsLive)
    {
        bg = Background.Danger;
    }
    <AuthorizeView Roles="@RoleGroups.AdminTranslatorAmendEditor">
        <Authorized>
            <Anchor To=@($"/Amendment/{Amendment.Id}/Body/Edit/{body.Language}")>
                <Badge Background="bg">@Language.Name</Badge>
            </Anchor>
        </Authorized>
        <NotAuthorized>
            <Badge Background="bg">@Language.Name</Badge>
        </NotAuthorized>
    </AuthorizeView>
}
else
{
    <AuthorizeView Roles="@RoleGroups.AdminTranslatorAmendEditor">
        <Authorized>
            <Anchor To=@($"/Amendment/{Amendment.Id}/Body/Create/{Language.Code}")>
                <Badge Background="Background.Light" TextColor="TextColor.Black50">@Language.Name</Badge>
            </Anchor>
        </Authorized>
        <NotAuthorized>
            <Badge Background="Background.Light" TextColor="TextColor.Black50">@Language.Name</Badge>
        </NotAuthorized>
    </AuthorizeView>
}
@code {
    [Parameter, EditorRequired]
    public ApiAmendment Amendment { get; set; } = null!;

    [Parameter, EditorRequired]
    public ApiLanguage Language { get; set; } = null!;

    [Parameter]
    public bool IsLive { get; set; }
}
