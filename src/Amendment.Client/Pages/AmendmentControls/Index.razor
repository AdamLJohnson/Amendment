@page "/Amendment"
@using Microsoft.AspNetCore.Authorization
@using Amendment.Client.Repository.GraphQl
@using Amendment.Shared
@attribute [Authorize]
@inject IAmendmentApi Api
@inject INotificationService NotificationService

<CustomPageTitle>Amendments</CustomPageTitle>

<h3>Amendments</h3>

<Row>
    <Column>
        <AuthorizeView Roles="@RoleGroups.AdminScreenController">
            <Authorized>
                @if (_presentation?.ActiveAmendmentId is not null)
                {
                    <Button Color="Color.Danger" Clicked="ClearScreens">Clear Screens</Button>
                }
            </Authorized>
        </AuthorizeView>
    </Column>
    <Column TextAlignment="TextAlignment.End">
        <AuthorizeView Roles="@RoleGroups.AdminAmendEditor">
            <Button Color="Color.Success" Type="ButtonType.Link" To="/Amendment/Create">Create Amendment</Button>
        </AuthorizeView>
    </Column>
</Row>

<Table Striped>
    <TableHeader>
        <TableRow>
            <TableHeaderCell>Title</TableHeaderCell>
            <TableHeaderCell>Author</TableHeaderCell>
            <TableHeaderCell>Motion</TableHeaderCell>
            <TableHeaderCell Style="min-width: 200px"></TableHeaderCell>
            <TableHeaderCell Style="min-width: 300px"></TableHeaderCell>
        </TableRow>
    </TableHeader>
    <TableBody>
        <Repeater Items="@_amendments">
            <AmendmentTableRow Model="context" Languages="_languages" Presentation="_presentation" OnDelete="RefreshAmendments"/>
        </Repeater>
        @if (!_amendments.Any())
        {
            <TableRow>
                <TableRowCell ColumnSpan="5">No Amendments Found</TableRowCell>
            </TableRow>
        }
    </TableBody>
</Table>

<Row>
    <Column>
        <h4>Key:</h4>
        <Badge Background="Background.Light" TextColor="TextColor.Black50">Not Created</Badge>
        <Badge Background="Background.Primary">Not Ready</Badge>
        <Badge Background="Background.Success">Is Ready</Badge>
        <Badge Background="Background.Danger">Is Live</Badge>
    </Column>
    <Column TextAlignment="TextAlignment.Center">
        <AuthorizeView Roles="@RoleGroups.AdminAmendEditor">
            <Authorized>
                <Check TValue="bool" @bind-Value="ShowArchived">
                    <ChildContent>Show Archived Amendments</ChildContent>
                </Check>
            </Authorized>
        </AuthorizeView>
    </Column>
</Row>


@code {
    List<ApiAmendment> _amendments = new();
    List<ApiAmendment> _allAmendments = new();
    IReadOnlyList<ApiLanguage> _languages = [];
    ApiPresentation? _presentation;
    private bool _showArchived = false;

    // This property is used to handle the checkbox binding and trigger filtering
    private bool ShowArchived
    {
        get => _showArchived;
        set
        {
            if (_showArchived != value)
            {
                _showArchived = value;
                FilterAmendments();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAmendments();
    }

    private async Task LoadAmendments()
    {
        try
        {
            if (_languages.Count == 0)
                _languages = await Api.GetLanguagesAsync();
            _presentation = await Api.GetPresentationAsync();
            var all = new List<ApiAmendment>();
            foreach (var archived in new[] { false, true })
            {
                string? nextToken = null;
                do
                {
                    var page = await Api.GetAmendmentsAsync(archived, 100, nextToken);
                    all.AddRange(page.Items);
                    nextToken = page.NextToken;
                } while (nextToken is not null);
            }
            _allAmendments = all.OrderBy(a => a.Created.At).ThenBy(a => a.Id, StringComparer.Ordinal).ToList();
        }
        catch (AmendmentApiException ex)
        {
            await NotificationService.Error(ex.Message, "Amendments");
        }
        FilterAmendments();
    }

    private void FilterAmendments()
    {
        _amendments = _showArchived
            ? _allAmendments.ToList()
            : _allAmendments.Where(a => !a.IsArchived).ToList();
        StateHasChanged();
    }

    private Task RefreshAmendments()
    {
        return LoadAmendments();
    }

    private async Task ClearScreens()
    {
        if (_presentation == null)
            return;

        try
        {
            _presentation = await Api.ClearPresentationAsync(_presentation.Version);
        }
        catch (AmendmentApiException ex)
        {
            await NotificationService.Error(ex.Message, "Clear Screens");
            _presentation = await Api.GetPresentationAsync();
        }
    }

}
