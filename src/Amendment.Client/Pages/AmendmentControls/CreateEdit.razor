@page "/Amendment/Create"
@page "/Amendment/Edit/{Id}"
@using Microsoft.AspNetCore.Authorization
@using Amendment.Client.Repository.GraphQl
@using Amendment.Shared
@attribute [Authorize(Roles = RoleGroups.AdminAmendEditor)]
@inject IAmendmentApi Api
@inject NavigationManager NavigationManager
@inject INotificationService NotificationService

<CustomPageTitle>@_title</CustomPageTitle>

<h3>
    @_title
    @if (Id != null && _model.IsArchived)
    {
        <Badge Margin="Margin.Is2.FromStart" Color="Color.Secondary">ARCHIVED</Badge>
    }
</h3>

<EditForm Model="_model" OnValidSubmit="OnSave">
        <Row>
            <Column ColumnSize="ColumnSize.Is6">
                <Field>
                    <FieldLabel For="amendmentTitle">Amendment Title</FieldLabel>
                    <TextInput id="amendmentTitle" @bind-Value="_model.Title" Placeholder="Amendment Title"></TextInput>
                </Field>
                <Field>
                    <FieldLabel For="author">Author</FieldLabel>
                    <TextInput id="author" @bind-Value="_model.Author" Placeholder="Author"></TextInput>
                </Field>
                <Field>
                    <FieldLabel For="motion">Motion</FieldLabel>
                    <TextInput id="motion" @bind-Value="_model.Motion" Placeholder="Motion"></TextInput>
                </Field>
                <Field>
                    <FieldLabel For="source">Source</FieldLabel>
                    <TextInput id="source" @bind-Value="_model.Source" Placeholder="Source"></TextInput>
                </Field>
                <Field>
                    <FieldLabel For="legisId">Legislative ID</FieldLabel>
                    <TextInput id="legisId" @bind-Value="_model.LegisId" Placeholder="Legislative ID"></TextInput>
                </Field>
                @if (Id != null) // Only show archive checkbox for existing amendments
                {
                    <Field>
                        <FieldLabel>Archive Status</FieldLabel>
                        <Check TValue="bool" @bind-Value="_model.IsArchived">
                            <ChildContent>Archive this amendment</ChildContent>
                        </Check>
                        <FieldHelp>Archived amendments are hidden from the main list by default</FieldHelp>
                    </Field>
                }
            </Column>
            <Column ColumnSize="ColumnSize.Is6">
                <Field>
                    <FieldLabel For="primaryLanguage">Primary Language</FieldLabel>
                    <Select id="primaryLanguage" @bind-Value="@_model.PrimaryLanguage" TValue="string">
                        <ChildContent>
                            <Repeater Items="_language">
                                <ChildContent Context="languageItem">
                                    <SelectItem Value="@languageItem.Code">@languageItem.Name</SelectItem>
                                </ChildContent>
                            </Repeater>
                        </ChildContent>
                    </Select>
                </Field>
                @if (Id == null)
                {
                    <Field>
                        <FieldLabel For="amendmentBody">Amendment Body</FieldLabel>
                        @if (_initialized)
                        {
                            <Markdown @bind-Value="@_bodyMarkdown" id="amendmentBody" UploadImage="false" SpellChecker="false" InsertTexts=@(new MarkdownInsertTexts() {HorizontalRule = new []{"", "**NEWSLIDE**"}, Link = new []{"<u>", "</u>"}, Table = new []{"<span style=\"color: red;\">", "</span>"}})>
                                <Toolbar>
                                    <MarkdownToolbarButton Action="MarkdownAction.Bold"/>
                                    <MarkdownToolbarButton Action="MarkdownAction.Italic" />
                                    <MarkdownToolbarButton Action="MarkdownAction.Strikethrough" />
                                    <MarkdownToolbarButton Action="MarkdownAction.Link" Icon="fa fa-underline" />
                                    @*<MarkdownToolbarButton Action="MarkdownAction.Table" Icon="fa fa-tint" />*@
                                    <MarkdownToolbarButton Action="MarkdownAction.Heading" />
                                    <MarkdownToolbarButton Action="MarkdownAction.Quote" Separator />
                                    <MarkdownToolbarButton Action="MarkdownAction.UnorderedList" />
                                    <MarkdownToolbarButton Action="MarkdownAction.OrderedList" />
                                    <MarkdownToolbarButton Action="MarkdownAction.Link" Separator />
                                    <MarkdownToolbarButton Action="MarkdownAction.Image" />
                                    <MarkdownToolbarButton Action="MarkdownAction.HorizontalRule" Icon="fa fa-plus" Separator />
                                </Toolbar>
                            </Markdown>
                        }
                    </Field>
                }
                else
                {
                    <AmendmentEditBodies AmendmentId="@(Id!)" PrimaryLanguage="@_model.PrimaryLanguage" AmendmentBodies="_bodies" Languages="_language"></AmendmentEditBodies>
                }
            </Column>
        </Row>

    <Button Color="Color.Primary" Type="ButtonType.Submit">Save</Button>
</EditForm>

@code {
    [Parameter]
    public string? Id { get; set; }
    string _title = "";
    IReadOnlyList<ApiLanguage> _language = [];
    List<ApiAmendmentBody> _bodies = new();
    private bool _initialized;

    AmendmentForm _model = new();
    string _bodyMarkdown = "";
    ApiAmendment? _existing;

    private sealed class AmendmentForm
    {
        public string Title { get; set; } = "";
        public string Author { get; set; } = "";
        public string? Motion { get; set; }
        public string? Source { get; set; }
        public string? LegisId { get; set; }
        public string PrimaryLanguage { get; set; } = "";
        public bool IsArchived { get; set; }

        public ApiAmendmentInput ToInput(string? parentAmendmentId) =>
            new(Title, Author, PrimaryLanguage, Motion, Source, LegisId, parentAmendmentId);
    }

    protected override async Task OnInitializedAsync()
    {
        _title = Id == null ? "Create Amendment" : "Edit Amendment";
        try
        {
            _language = await Api.GetLanguagesAsync();
            _model.PrimaryLanguage = _language.FirstOrDefault()?.Code ?? "";
            if (Id != null)
            {
                _existing = await Api.GetAmendmentAsync(Id);
                if (_existing == null)
                {
                    await NotificationService.Error("The amendment was not found.", "Amendment Error");
                    return;
                }
                _model = new AmendmentForm
                {
                    Title = _existing.Title, Author = _existing.Author, Motion = _existing.Motion, Source = _existing.Source,
                    LegisId = _existing.LegisId, PrimaryLanguage = _existing.PrimaryLanguage, IsArchived = _existing.IsArchived
                };
                _bodies = _existing.Bodies.ToList();
            }
        }
        catch (AmendmentApiException ex)
        {
            await NotificationService.Error(ex.Message, "Amendment Error");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _initialized = true;
            StateHasChanged(); // Trigger render of Markdown now that DOM is ready
        }
    }

    protected async Task OnSave()
    {
        if (Id == null && string.IsNullOrEmpty(_bodyMarkdown))
        {
            await NotificationService.Error("Amendment Body can not be empty", "Error");
            return;
        }

        try
        {
            if (Id == null)
            {
                // A retry after a failed body create reuses the amendment created by the first attempt
                _existing ??= await Api.CreateAmendmentAsync(_model.ToInput(null));
                await Api.CreateBodyAsync(_existing.Id, _existing.PrimaryLanguage, _bodyMarkdown, ApiBodyStatus.Ready);
            }
            else if (_existing != null)
            {
                _existing = await Api.UpdateAmendmentAsync(_existing.Id, _existing.Version, _model.ToInput(_existing.ParentAmendmentId), _existing.IsApproved);
                if (_existing.IsArchived != _model.IsArchived)
                    _existing = await Api.ArchiveAmendmentAsync(_existing.Id, _existing.Version, _model.IsArchived);
            }
            NavigationManager.NavigateTo("/Amendment");
        }
        catch (AmendmentApiException ex)
        {
            await NotificationService.Error(ex.Field is null ? ex.Message : $"{ex.Field}: {ex.Message}", "Amendment Error");
        }
        StateHasChanged();
    }

}
