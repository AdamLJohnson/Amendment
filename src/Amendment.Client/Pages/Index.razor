@page "/"
@using Amendment.Client.Repository.GraphQl
@inject IAmendmentApi Api
@inject INotificationService NotificationService

<CustomPageTitle>Amendments</CustomPageTitle>

<h1>Amendments</h1>

<Row>
    <Repeater Items="_languages" TItem="ApiLanguage">
        <Column ColumnSize="ColumnSize.Is4">
            <h4>@context.Name</h4>
            @{
                var view = _presentation?.Languages.FirstOrDefault(x => x.Language == context.Code && x.Visible);
            }

            @if (view != null)
            {
                <div class=@($"small-screen-container well slideonline {context.Name}")>
                    <AmendmentBodySingleRenderer BodyText="@view.CurrentSlide"></AmendmentBodySingleRenderer>
                </div>
            }
            else
            {
                <div class=@($"small-screen-container well fill-well slideoffline {context.Name}")></div>
            }
            <Div TextAlignment="TextAlignment.Center">
                <Button Color="Color.Primary" Type="ButtonType.Link" To=@($"/View/{context.Name}")>View</Button>
            </Div>
        </Column>
    </Repeater>
</Row>

@code
{
    IReadOnlyList<ApiLanguage> _languages = [];
    ApiPublicPresentation? _presentation;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _languages = await Api.GetLanguagesAsync();
            _presentation = await Api.GetPublicPresentationAsync();
        }
        catch (Exception ex) when (ex is AmendmentApiException or HttpRequestException)
        {
            await NotificationService.Error(ex.Message, "Amendments");
        }
    }
}
