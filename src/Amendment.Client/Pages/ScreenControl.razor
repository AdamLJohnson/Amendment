@page "/ScreenControl"
@using Microsoft.AspNetCore.Authorization
@using Amendment.Client.Repository.GraphQl
@using Amendment.Shared
@attribute [Authorize(Roles = RoleGroups.AdminScreenController)]
@inject IAmendmentApi Api
@inject INotificationService NotificationService

<CustomPageTitle>Screen Control</CustomPageTitle>
<h3>Screen Control</h3>

@if (_amendment != null)
{
    <Row>
        <Column ColumnSize="ColumnSize.Is3">
            <Field>
                <FieldLabel>Title</FieldLabel>
                <p>@_amendment.Title</p>
            </Field>
        </Column>
        <Column ColumnSize="ColumnSize.Is3">
            <Field>
                <FieldLabel>Author</FieldLabel>
                <p>@_amendment.Author</p>
            </Field>
        </Column>
        <Column ColumnSize="ColumnSize.Is3">
            <Field>
                <FieldLabel>Motion</FieldLabel>
                <p>@_amendment.Motion</p>
            </Field>
        </Column>
    </Row>
    <hr />
    <h4>Amendment Texts</h4>
    <Row>
        <Column ColumnSize="ColumnSize.Is4.OnDesktop">
            <Button Color="Color.Success" Clicked="() => _showPreview = !_showPreview">Change Views</Button>
        </Column>
        <Column ColumnSize="ColumnSize.Is4.OnDesktop">
            @if (_presentation!.Languages.Any(x => x.Visible))
            {
                <Button Color="Color.Danger" Block Size="Size.Large" Clicked="TakeAllDown">Take all down</Button>
            }
            else
            {
                <Button Color="Color.Success" Block Size="Size.Large" Clicked="AllGoLive">All Go Live</Button>
            }
        </Column>
        <Column ColumnSize="ColumnSize.Is4.OnDesktop" TextAlignment="TextAlignment.End">
            <Button Color="Color.Warning" Clicked="ResetAllPages">Reset All</Button>
            <Button Color="Color.Info" Clicked="AllPrevPage">All Prev</Button>
            <Button Color="Color.Info" Clicked="AllNextPage">All Next</Button>
        </Column>
    </Row>
    <Row Style="margin-top:10px;">
        <Repeater Items="@OrderedBodies">
            <Column ColumnSize="ColumnSize.Is4.OnDesktop">
                <ScreenControlItem
                    Body="@context"
                    LanguageName="@(_languages.FirstOrDefault(x => x.Code == context.Language)?.Name ?? context.Language)"
                    IsPrimary="@(context.Language == _amendment.PrimaryLanguage)"
                    Screen="@ScreenFor(context.Language)"
                    ShowPreview="@_showPreview"
                    OnChange="@(change => ApplyAsync([change]))"></ScreenControlItem>
            </Column>
        </Repeater>
    </Row>
}
else
{
    <h4>No amendments are currently live</h4>
    <Button Color="Color.Primary" Type="ButtonType.Link" To=@("/Amendment")>Go to Amendments</Button>
}

@code {
    ApiAmendment? _amendment = null;
    ApiPresentation? _presentation;
    IReadOnlyList<ApiLanguage> _languages = [];
    bool _showPreview = true;

    private IEnumerable<ApiAmendmentBody> OrderedBodies =>
        _amendment!.Bodies.OrderBy(b => _languages.FirstOrDefault(l => l.Code == b.Language)?.SortOrder ?? int.MaxValue);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _languages = await Api.GetLanguagesAsync();
            await LoadAsync();
        }
        catch (AmendmentApiException ex)
        {
            await NotificationService.Error(ex.Message, "Screen Control");
        }
    }

    private async Task LoadAsync()
    {
        _presentation = await Api.GetPresentationAsync();
        _amendment = _presentation.ActiveAmendmentId is { } id ? await Api.GetAmendmentAsync(id) : null;
    }

    private ApiLanguageScreen ScreenFor(string language) =>
        _presentation?.Languages.FirstOrDefault(l => l.Language == language) ?? new ApiLanguageScreen(language, false, 0);

    /// <summary>Legacy page rule: a page outside the slide range resets to 0 (matches the server).</summary>
    private static int NormalizePage(int page, int pageCount) => page < 0 || page > pageCount - 1 ? 0 : page;

    private async Task ApplyAsync(IReadOnlyList<ApiLanguageChange> changes)
    {
        if (_presentation == null || changes.Count == 0)
            return;
        try
        {
            _presentation = await Api.SetLanguagePresentationAsync(_presentation.Version, changes);
        }
        catch (AmendmentApiException ex)
        {
            await NotificationService.Error(ex.Message, "Screen Control");
            await LoadAsync();
        }
    }

    private Task TakeAllDown() =>
        ApplyAsync(_amendment!.Bodies.Where(x => ScreenFor(x.Language).Visible).Select(x => new ApiLanguageChange(x.Language, Visible: false)).ToList());

    private Task AllGoLive() =>
        ApplyAsync(_amendment!.Bodies.Where(x => !ScreenFor(x.Language).Visible).Select(x => new ApiLanguageChange(x.Language, Visible: true)).ToList());

    private Task ResetAllPages() =>
        ApplyAsync(_amendment!.Bodies.Select(x => new ApiLanguageChange(x.Language, Page: 0)).ToList());

    private Task AllPrevPage() =>
        ApplyAsync(_amendment!.Bodies.Select(x => new ApiLanguageChange(x.Language, Page: NormalizePage(ScreenFor(x.Language).Page - 1, x.PageCount))).ToList());

    private Task AllNextPage() =>
        ApplyAsync(_amendment!.Bodies.Select(x => new ApiLanguageChange(x.Language, Page: NormalizePage(ScreenFor(x.Language).Page + 1, x.PageCount))).ToList());

}
