<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="compilerconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="compilerconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Blazorise.Bootstrap5" Version="2.4.1" />
    <PackageReference Include="Blazorise.Components" Version="2.4.0" />
    <PackageReference Include="Blazorise.FluentValidation" Version="2.4.0" />
    <PackageReference Include="Blazorise.Icons.FontAwesome" Version="2.4.0" />
    <PackageReference Include="Blazorise.Markdown" Version="2.4.0" />
    <PackageReference Include="Blazorise.Snackbar" Version="2.4.0" />
    <PackageReference Include="BuildWebCompiler2022" Version="1.14.15" Condition="'$(OS)' == 'Windows_NT'" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Toolbelt.Blazor.HttpClientInterceptor" Version="10.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Amendment.Client.Repository\Amendment.Client.Repository.csproj" />
    <ProjectReference Include="..\Amendment.Shared\Amendment.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Watch Include="**\*.css" />
    <Watch Include="**\*.js" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Components\TimerComponent.razor.less" />
  </ItemGroup>
  <ItemGroup>
    <Watch Remove="wwwroot\js\ViewFullScreen.js" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Components\TimerComponent.razor.less" />
  </ItemGroup>
</Project>