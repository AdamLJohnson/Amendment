@using Amendment.Client.Repository.GraphQl

<h5>
    <Row>
        <Column ColumnSize="ColumnSize.Is4" Style="white-space: nowrap;">
            @LanguageName
            <Icon Name="IconName.ArrowUp" Clicked="PrevPage"></Icon>
            <Icon Name="IconName.ArrowDown" Clicked="NextPage"></Icon>
        </Column>
        <Column ColumnSize="ColumnSize.Is4" TextAlignment="TextAlignment.Center">
            @if (IsPrimary)
            {
                <Badge Color="Color.Primary">PRIMARY</Badge>
                <span></span>
            }
        </Column>
        <Column ColumnSize="ColumnSize.Is4" TextAlignment="TextAlignment.End">
            <Button Color=@(Screen.Visible ? Color.Danger : Color.Info) Size="Size.Small" Clicked="ToggleIsLive">LIVE</Button>
        </Column>
    </Row>
</h5>
@{
    var textPrev = "";
    if (ShowPreview)
    {
        textPrev = "text-preview";
    }
}
<Div Class="@($"small-screen-container well {textPrev} fill-well")">
    <div>
        <AmendmentBodyMultiRenderer BodyText="@Body.Markdown" ActivePage="@Screen.Page"></AmendmentBodyMultiRenderer>
    </div>
</Div>
<Div TextAlignment="TextAlignment.Center">
    @if (!Screen.Visible)
    {
        <Button Color="Color.Success" Clicked="ToggleIsLive">GO LIVE</Button>
    }
    else
    {
        <Button Color="Color.Danger" Clicked="ToggleIsLive">TAKE DOWN</Button>
    }
</Div>

@code {

    [Parameter, EditorRequired]
    public ApiAmendmentBody Body { get; set; } = null!;

    [Parameter, EditorRequired]
    public string? LanguageName { get; set; }

    [Parameter, EditorRequired]
    public bool IsPrimary { get; set; }

    [Parameter, EditorRequired]
    public ApiLanguageScreen Screen { get; set; } = null!;

    [Parameter, EditorRequired]
    public bool ShowPreview { get; set; } = true;

    [Parameter, EditorRequired]
    public EventCallback<ApiLanguageChange> OnChange { get; set; }

    private Task ToggleIsLive() => OnChange.InvokeAsync(new ApiLanguageChange(Body.Language, Visible: !Screen.Visible));

    private Task NextPage() => ChangePage(Screen.Page + 1);

    private Task PrevPage() => ChangePage(Screen.Page - 1);

    // Legacy page rule: a page outside the slide range resets to 0
    private Task ChangePage(int page) =>
        OnChange.InvokeAsync(new ApiLanguageChange(Body.Language, Page: page < 0 || page > Body.PageCount - 1 ? 0 : page));

}
